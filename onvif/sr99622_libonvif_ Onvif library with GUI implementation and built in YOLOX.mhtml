<p dir=3D"auto">A script to get a list of active samba accounts</p>
<div class=3D"snippet-clipboard-content notranslate position-relative overf=
low-auto"><pre class=3D"notranslate"><code>#!/bin/bash

# Run pdbedit and extract only the Unix usernames
sudo pdbedit -L -v | while IFS=3D read -r line; do
  # Skip empty lines
  [[ -z "$line" ]] &amp;&amp; continue

  # Match only lines that start with "Unix username:"
  if [[ "$line" =3D=3D "Unix username:"* ]]; then
    value=3D"${line#Unix username: }"
    echo "$value"
  fi
done

</code></pre><div class=3D"zeroclipboard-container">
