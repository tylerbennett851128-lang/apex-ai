{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "isolatedModules": true,
    "strictNullChecks": false,
    "noImplicitAny": false
  },

  "paths": {
    "$src": ["./src"],
    "$src/*": ["./src/*"],

    "$lib": ["./src/lib"],
    "$lib/*": ["./src/lib/*"],

    "$assets": ["./src/assets"],
    "$assets/*": ["./src/assets/*"],

    "$config": ["./src/config"],
    "$config/*": ["./src/config/*"],

    "$components": ["./src/components"],
    "$components/*": ["./src/components/*"],

    "$mc": ["./src/mc"],
    "$mc/*": ["./src/mc/*"]
  }
}
