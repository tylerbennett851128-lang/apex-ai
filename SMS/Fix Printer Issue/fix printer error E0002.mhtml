<ul data-start=3D"601" data-end=3D"806">
<li data-start=3D"601" data-end=3D"640" data-section-id=3D"p1lb1h">
<p data-start=3D"603" data-end=3D"640">Dirty or poorly contacting thermisto=
r</p>
